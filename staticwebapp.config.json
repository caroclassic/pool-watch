{
  "globalHeaders": {
    "Cache-Control": "no-cache",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "routes": [
    { "route": "/v2", "redirect": "/", "statusCode": 301 },
    { "route": "/v2/index.html", "redirect": "/", "statusCode": 301 },
    { "route": "/v2/players.html", "redirect": "/players.html", "statusCode": 301 },
    { "route": "/v2/about.html", "redirect": "/about.html", "statusCode": 301 },
    { "route": "/v2/*", "redirect": "/", "statusCode": 301 },
    { "route": "/dev/*", "statusCode": 404 },
    { "route": "/tests/*", "statusCode": 404 },
    { "route": "/js/*", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "route": "/css/*", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "route": "/fonts/*", "headers": { "Cache-Control": "public, max-age=2592000" } },
    { "route": "/*.png", "headers": { "Cache-Control": "public, max-age=86400" } }
  ],
  "mimeTypes": {
    ".woff2": "font/woff2",
    ".js": "text/javascript; charset=utf-8",
    ".json": "application/json; charset=utf-8"
  }
}
