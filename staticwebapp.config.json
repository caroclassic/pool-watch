{
  "globalHeaders": {
    "Cache-Control": "no-cache",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "SAMEORIGIN"
  },
  "routes": [
    { "route": "/v2", "redirect": "/v2/", "statusCode": 301 },
    { "route": "/v2/js/*", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "route": "/v2/css/*", "headers": { "Cache-Control": "public, max-age=86400" } },
    { "route": "/v2/fonts/*", "headers": { "Cache-Control": "public, max-age=2592000" } },
    { "route": "/*.png", "headers": { "Cache-Control": "public, max-age=86400" } }
  ],
  "mimeTypes": {
    ".woff2": "font/woff2",
    ".js": "text/javascript; charset=utf-8",
    ".json": "application/json; charset=utf-8"
  }
}
